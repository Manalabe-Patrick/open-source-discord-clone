DATABASE_URL="postgresql://postgres:postgres@localhost:5433/discord_clone_dev"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL intentionally omitted: next-auth rewrites every /api/auth/*
# request's origin to match this value if set, which breaks login when the
# app is reached via an IP/hostname other than this one (e.g. LAN access
# via `npm run dev:lan` - see that script in package.json). Only set this
# if you need a fixed canonical URL (e.g. prod).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_SOCKET_SERVER_URL="http://localhost:4000"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
